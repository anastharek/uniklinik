# Copy to .env and fill in real values (docker-compose.yml reads these).
# .env is gitignored — secrets never go into the repository.

# JWT signing secret — generate with: openssl rand -base64 32
TOKEN_SECRET=changeme

# Orthanc credentials (used by the app to talk to Orthanc, and registered
# as the Orthanc REST/DICOM-web user)
ORTHANC_USERNAME=REDACTED
ORTHANC_PASSWORD=changeme

# Admin password for the preferences endpoint
ADMIN_PASSWORD=changeme
