.SeriesFilterPreferences
  padding: 20px
  color: #8ea4b8
  font-size: 11px

  .filter-description
    margin-bottom: 20px
    p
      font-size: 12px
      line-height: 1.5
      color: #8ea4b8

  .add-pattern-section
    margin-bottom: 20px

    label
      display: block
      margin-bottom: 8px
      font-weight: 600
      font-size: 11px
      letter-spacing: 0.03em
      text-transform: uppercase
      color: #cbd5e1

    .input-group
      display: flex
      gap: 8px

      input
        flex: 1
        padding: 8px 12px
        border: 1px solid #2a2a2a
        border-radius: 6px
        background: #1a1a1a
        color: #cbd5e1
        font-size: 12px
        font-family: 'SF Mono', 'Menlo', 'Monaco', 'Consolas', monospace

        &:focus
          outline: none
          border-color: #22d3ee

        &::placeholder
          color: #64748b

      .add-btn
        padding: 8px 16px
        background: #1e293b
        color: #22d3ee
        border: 1px solid rgba(34, 211, 238, 0.25)
        border-radius: 6px
        cursor: pointer
        font-size: 11px
        font-weight: 500
        letter-spacing: 0.03em
        transition: all 0.15s ease

        &:disabled
          background: #1a1a1a
          border-color: #2a2a2a
          color: #64748b
          cursor: not-allowed

        &:hover:not(:disabled)
          background: #1e3a5f
          border-color: #22d3ee

  .suggested-patterns
    margin-bottom: 20px

    label
      display: block
      margin-bottom: 10px
      font-weight: 600
      font-size: 11px
      letter-spacing: 0.03em
      text-transform: uppercase
      color: #cbd5e1

    .suggested-list
      display: flex
      flex-wrap: wrap
      gap: 6px

      .suggested-btn
        padding: 5px 10px
        background: #1a1a1a
        color: #8ea4b8
        border: 1px solid #2a2a2a
        border-radius: 6px
        cursor: pointer
        font-size: 11px
        font-family: 'SF Mono', 'Menlo', 'Monaco', 'Consolas', monospace
        transition: all 0.15s ease

        &:hover:not(:disabled)
          background: #252525
          color: #cbd5e1
          border-color: #3a5a6a

        &:disabled
          background: rgba(34, 211, 238, 0.08)
          color: #22d3ee
          border-color: rgba(34, 211, 238, 0.2)
          cursor: default

  .blocked-list-section
    label
      display: block
      margin-bottom: 10px
      font-weight: 600
      font-size: 11px
      letter-spacing: 0.03em
      text-transform: uppercase
      color: #cbd5e1

    .no-blocked
      color: #64748b
      font-style: italic
      padding: 10px 0
      font-size: 11px

    .blocked-list
      list-style: none
      padding: 0
      margin: 0
      max-height: 200px
      overflow-y: auto

      .blocked-item
        display: flex
        justify-content: space-between
        align-items: center
        padding: 8px 12px
        background: #1a1a1a
        border: 1px solid #2a2a2a
        border-radius: 6px
        margin-bottom: 6px

        .pattern-text
          font-family: 'SF Mono', 'Menlo', 'Monaco', 'Consolas', monospace
          font-size: 12px
          color: #f87171

        .remove-btn
          width: 22px
          height: 22px
          background: #7f1d1d
          color: #fca5a5
          border: 1px solid #991b1b
          border-radius: 4px
          cursor: pointer
          font-size: 14px
          line-height: 1
          display: flex
          align-items: center
          justify-content: center
          transition: all 0.15s ease

          &:hover
            background: #991b1b
            color: #fecaca

.TabFooter
  display: flex
  justify-content: space-between
  align-items: center
  padding: 15px 20px
  border-top: 1px solid #2a2a2a
  margin-top: 20px

  .btn
    padding: 8px 16px
    border: none
    border-radius: 6px
    cursor: pointer
    font-size: 11px
    font-weight: 500
    letter-spacing: 0.03em
    transition: all 0.15s ease

    &.btn-danger
      background: #7f1d1d
      color: #fca5a5

      &:hover
        background: #991b1b

    &.btn-secondary
      background: #1a1a1a
      color: #8ea4b8
      border: 1px solid #2a2a2a
      margin-right: 8px

      &:hover
        background: #252525
        color: #cbd5e1

    &.btn-primary
      background: #1e293b
      color: #22d3ee
      border: 1px solid rgba(34, 211, 238, 0.25)

      &:hover
        background: #1e3a5f

  .right-buttons
    display: flex

.admin-sync-section
  padding: 0 20px 15px 20px
  border-top: 1px solid #2a2a2a
  margin-top: 10px
  padding-top: 15px

  .admin-label
    display: block
    margin-bottom: 8px
    font-weight: 600
    font-size: 10px
    text-transform: uppercase
    letter-spacing: 0.05em
    color: #64748b

  .admin-input-group
    input.admin-password-input
      width: 100%
      padding: 8px 12px
      border: 1px solid #2a2a2a
      border-radius: 6px
      background: #1a1a1a
      color: #cbd5e1
      font-size: 12px

      &:focus
        outline: none
        border-color: #e29e4a

      &::placeholder
        color: #64748b

  .sync-status
    margin-top: 8px
    font-size: 11px
    padding: 6px 10px
    border-radius: 4px

    &.success
      color: #34d399
      background: rgba(52, 211, 153, 0.08)

    &.error
      color: #f87171
      background: rgba(248, 113, 113, 0.08)
