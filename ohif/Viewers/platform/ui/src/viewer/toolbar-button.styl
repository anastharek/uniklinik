.toolbar-button
  height: 48px
  color: #8ea4b8
  float: left
  text-align: center
  padding: 4px 8px
  cursor: pointer
  border-radius: 6px
  background: transparent
  transition: all 0.15s ease
  -webkit-touch-callout: none
  -webkit-user-select: none
  -khtml-user-select: none
  -moz-user-select: none
  -ms-user-select: none
  user-select: none

  .toolbar-button-label
    font-size: 10px
    font-weight: 400
    letter-spacing: 0.03em
    margin-top: 2px
    color: inherit

  .expand-caret
    width: 8px
    height: 8px
    transform: translate(2px, 2px)

  svg
    height: 20px
    width: 20px
    margin: 1px 0 0 0
    stroke-width: 2
    color: inherit

  &:hover
    color: #cbd5e1
    background-color: rgba(42, 63, 84, 0.3)

  &.active, &:active
    color: #22d3ee
    background-color: #2a3f54
    box-shadow: inset 0 2px 0 #22d3ee
