:root {
  --text-secondary-color: #8ea4b8;
  --active-color: #22d3ee;
  --primary-background-color: #1a1a1a;
  --ui-border-color-dark: #2a2a2a;
  --sidebar-transition: all 0.2s ease;
}

.ImageThumbnail.active
  background-color: #1e293b;
  border-color: var(--active-color);
  box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.4), 0 4px 12px rgba(0, 0, 0, 0.4)
  transition: var(--sidebar-transition);

.ImageThumbnail
  background-color: var(--primary-background-color);
  box-shadow: inset 0 0 0 1px var(--ui-border-color-dark);
  border: 2px solid #2a2a2a;
  border-radius: 10px
  height: 135px
  margin: 0 auto
  padding 4px
  position: relative
  transition: var(--sidebar-transition);
  width: 217px
  -moz-background-clip: padding
  -webkit-background-clip: padding
  background-clip: padding-box
  touch-action: pan-y

  &:hover
    border-color: #3a5a6a
    box-shadow: inset 0 0 0 1px #2a2a2a, 0 2px 8px rgba(0, 0, 0, 0.3)

  // Allow touch scroll to pass through canvas
  .image-thumbnail-canvas
    touch-action: pan-y
    canvas
      touch-action: pan-y

  // Thumbnail Loading Indicator

  .image-thumbnail-loading-indicator
    position: absolute
    left: 50%
    top: 50%
    margin: -22px 0 0 -22px
    display: block
    width: 44px
    height: 44px

    &:after
      content: " "
      display: block
      width: 32px
      height: 32px
      margin: 1px
      border-radius: 50%
      border: 3px solid var(--ui-border-color-dark)
      border-color: var(--ui-border-color-dark) transparent var(--ui-border-color-dark) transparent
      animation: image-thumbnail-loading-indicator 1.2s linear infinite

    @keyframes image-thumbnail-loading-indicator
      0%
        transform: rotate(0deg)
      100%
        transform: rotate(360deg)

  // The End...

.image-thumbnail-canvas
  height: 100%
  overflow: hidden
  display: flex
  justify-content: center
  border-radius: 8px
  background: #0a0a0a

  img
    -webkit-user-drag: none
    pointer-events: none

.thumbnailLoadingIndicator
  display: none
  pointer-events: none
  color: var(--text-secondary-color);
  height: 20px
  width: 100%
  top: 0
  left: 0
  right: 0
  bottom: 0
  margin: auto
  position: absolute

  &.d-block
    display: block;

  p
    text-align: center
    font-size: 10px

.image-thumbnail-progress-bar
  position: relative
  width: 100%
  height: 3px
  top: -6px

  .image-thumbnail-progress-bar-inner
    height: 100%
    min-width: 2px
    width: 0
    border-radius: 2px
    background-color: var(--active-color);
    transition: width 0.25s ease
    box-shadow: 0 0 6px rgba(34, 211, 238, 0.4)
