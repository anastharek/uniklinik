:root {
  --text-secondary-color: #8ea4b8;
  --active-color: #22d3ee;
  --primary-background-color: #1a1a1a;
  --ui-border-color-dark: #2a2a2a;
  --sidebar-transition: all 0.2s ease;
  --zip-color: #f59e0b;
}

/* ── Active state ── */
.ImageThumbnail.active
  background-color: #1e293b
  border-color: var(--active-color)
  box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.4), 0 4px 12px rgba(0, 0, 0, 0.4)
  transition: var(--sidebar-transition)

/* ── Base card ── */
.ImageThumbnail
  background-color: #0a0a0a
  border: 1px solid #2a2a2a
  border-radius: 10px
  height: 135px
  margin: 0 auto
  padding: 4px
  position: relative
  transition: var(--sidebar-transition)
  width: 217px
  touch-action: pan-y
  overflow: hidden

  &:hover
    border-color: #3a5a6a
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3)

  .image-thumbnail-canvas
    touch-action: pan-y
    canvas
      touch-action: pan-y

/* ── Canvas container ── */
.image-thumbnail-canvas
  height: 100%
  overflow: hidden
  display: flex
  justify-content: center
  border-radius: 8px
  background: #000000

  img
    -webkit-user-drag: none
    pointer-events: none
    object-fit: contain

/* ── Progress overlay (glassmorphism) ── */
.thumbnail-progress-overlay
  position: absolute
  inset: 4px
  border-radius: 8px
  background: rgba(0, 0, 0, 0.55)
  backdrop-filter: blur(1px)
  -webkit-backdrop-filter: blur(1px)
  display: flex
  align-items: center
  justify-content: center
  pointer-events: none
  z-index: 10

  .percent-badge
    font-size: 28px
    font-weight: 700
    font-family: 'SF Mono', 'Menlo', 'Monaco', 'Consolas', monospace
    color: #22d3ee
    text-shadow: 0 0 12px rgba(34, 211, 238, 0.4)
    letter-spacing: -0.02em

  &.zip-overlay .percent-badge
    color: #f59e0b
    text-shadow: 0 0 12px rgba(245, 158, 11, 0.4)

  .progress-bar-edge
    position: absolute
    bottom: 0
    left: 0
    right: 0
    height: 3px
    background: rgba(255, 255, 255, 0.06)

    .progress-bar-fill
      height: 100%
      background: #22d3ee
      box-shadow: 0 0 8px rgba(34, 211, 238, 0.5)
      border-radius: 0 2px 2px 0
      transition: width 0.3s ease
      min-width: 2px

      &.zip-fill
        background: #f59e0b
        box-shadow: 0 0 8px rgba(245, 158, 11, 0.5)

/* ── Plane indicator dot ── */
.plane-indicator
  position: absolute
  bottom: 6px
  left: 8px
  width: 8px
  height: 8px
  border-radius: 50%
  z-index: 10
  box-shadow: 0 0 6px currentColor
  pointer-events: none

/* ── Legacy progress bar (below thumbnail, when no overlay) ── */
.image-thumbnail-progress-bar
  position: relative
  width: 100%
  height: 3px
  top: -6px

  .image-thumbnail-progress-bar-inner
    height: 100%
    min-width: 2px
    width: 0
    border-radius: 2px
    background-color: var(--active-color)
    transition: width 0.25s ease
    box-shadow: 0 0 6px rgba(34, 211, 238, 0.4)

/* ── Legacy loading spinner ── */
.thumbnailLoadingIndicator
  display: none
  pointer-events: none
  color: var(--text-secondary-color)
  height: 20px
  width: 100%
  top: 0
  left: 0
  right: 0
  bottom: 0
  margin: auto
  position: absolute

  &.d-block
    display: block

  p
    text-align: center
    font-size: 10px
