@import './../../design/styles/common/global.styl'

:root {
  --series-count-background-color: #1e293b;
  --active-color: #22d3ee;
  --zip-color: #f59e0b;
}

/* ── Active state ── */
.thumbnail.active
  .alt-image-text
    border-color: var(--active-color)
    box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.3)

/* ── Base card container ── */
.thumbnail
  cursor: pointer
  display: table
  margin: 0 auto
  min-width: 90%
  padding-bottom: 0.5rem

  .alt-image-text
    align-items: center
    justify-content: center
    background-color: #0a0a0a
    box-shadow: inset 0 0 0 1px #2a2a2a
    border: 1px solid #2a2a2a
    border-radius: 10px
    min-height: 135px
    max-height: 250px
    margin: 0 auto
    padding: 5px
    position: relative
    transition: var(--sidebar-transition)
    width: 217px
    display: flex

    h1
      text-align: center
      color: #8ea4b8
      font-size: 12px
      font-weight: 500
      max-width: 200px
      max-height: 250px
      overflow-wrap: break-word
      word-wrap: break-word
      hyphens: auto

  .series-details
    display: flex
    flex-direction: column
    color: #8ea4b8
    font-size: 11px
    line-height: 1.4em
    margin-top: 6px
    margin-left: 0.5rem
    margin-right: 0.5rem
    max-width: 217px
    position: relative
    word-wrap: break-word
    letter-spacing: 0.02em

    .series-description
      flex-grow: 1
      font-weight: 500
      color: #cbd5e1

    &.info-only .series-description
      display: none

  .series-information
    display: flex
    flex-direction: row
    justify-content: space-between
    margin-top: 3px

    .item-frames .icon
      height: 18px

    .item-series.image-frames .icon
      background-color: var(--series-count-background-color)
      margin-top: 6px
      position: relative

      &:after
        content: ''
        background-color: var(--active-color)
        box-shadow: 1px 1px rgba(0, 0, 0, .115)
        left: -4px
        position: absolute
        top: -4px

      &
      &:after
        content: ''
        border: 0px solid var(--series-count-background-color)
        display: inline-block
        height: 11px
        width: 11px

    .warning
      margin: auto 0
      opacity: 1
      color: #e29e4a

      svg
        width: 16px
        height: 14px
        pointer-events: inherit

    .value
      color: #22d3ee
      display: inline-block
      font-family: 'SF Mono', 'Menlo', 'Monaco', 'Consolas', monospace
      font-size: 10px
      letter-spacing: 0.04em
      margin-left: 4px
      overflow: hidden
      text-overflow: ellipsis
      white-space: nowrap
      width: calc(100% - 15px)
      vertical-align: middle

    .icon
      color: var(--active-color)
      display: inline-block
      font-size: 9px
      font-weight: 700
      text-align: right
      width: 11px
      letter-spacing: 0.04em

/* ── Action buttons (Load + ZIP) ── */
.series-actions
  display: flex
  gap: 6px
  width: 100%
  margin-top: 6px
  touch-action: pan-y

  .action-btn
    flex: 1
    display: flex
    align-items: center
    justify-content: center
    gap: 4px
    padding: 5px 0
    border-radius: 6px
    cursor: pointer
    font-size: 10px
    font-weight: 500
    letter-spacing: 0.03em
    text-transform: uppercase
    transition: all 0.15s ease
    border: 1px solid transparent
    touch-action: pan-y
    -webkit-touch-callout: none
    user-select: none

    svg
      width: 12px
      height: 12px
      stroke-width: 2
      flex-shrink: 0

  /* Load button */
  .action-load
    background: rgba(34, 211, 238, 0.08)
    border-color: rgba(34, 211, 238, 0.15)
    color: #22d3ee

    &:hover
      background: rgba(34, 211, 238, 0.16)
      border-color: rgba(34, 211, 238, 0.35)
      color: #67e8f9

    &:active
      background: rgba(34, 211, 238, 0.24)
      border-color: rgba(34, 211, 238, 0.5)

    &.loading
      background: #1a2b3c
      border-color: rgba(34, 211, 238, 0.25)
      cursor: wait

      svg
        animation: action-spin 0.8s linear infinite

  /* ZIP button */
  .action-zip
    background: rgba(245, 158, 11, 0.08)
    border-color: rgba(245, 158, 11, 0.15)
    color: #f59e0b

    &:hover
      background: rgba(245, 158, 11, 0.16)
      border-color: rgba(245, 158, 11, 0.35)
      color: #fbbf24

    &:active
      background: rgba(245, 158, 11, 0.24)
      border-color: rgba(245, 158, 11, 0.5)

    &.loading
      background: #332a18
      border-color: rgba(245, 158, 11, 0.25)
      cursor: wait

      svg
        animation: action-spin 0.8s linear infinite

@keyframes action-spin
  from { transform: rotate(0deg) }
  to { transform: rotate(360deg) }
