.study-browser
  float: left
  height: 100%
  width: 100%
  overflow: hidden
  background-color: #121212
  padding-bottom: 20px
  padding-top: 10px

  .scrollable-study-thumbnails
    height: 100%
    overflow-y: auto
    overflow-x: hidden
    -webkit-overflow-scrolling: touch
    overscroll-behavior: contain
    touch-action: pan-y
    padding-bottom: 50px
    padding-right: 16px
    padding-left: 4px
    margin-right: -16px

    display: flex
    flex-direction: column

    &::-webkit-scrollbar
      display: none

    .thumbnail-container
      margin: 0 auto
      padding-bottom: 0.75rem
      padding: 0 4px
      touch-action: pan-y

      .noselect
        -moz-user-select: none
        -ms-user-select: none
        -khtml-user-select: none
        -webkit-user-select: none
        -webkit-touch-callout: none

    .show-more-series-wrapper
      padding: 8px 10px
      display: flex
      justify-content: center
      flex-shrink: 0

    .show-more-series-btn
      background: transparent
      border: 1px solid #2a3f54
      color: #8ea4b8
      font-size: 12px
      padding: 10px 16px
      border-radius: 6px
      cursor: pointer
      transition: background 0.2s, color 0.2s, border-color 0.2s
      width: 100%
      touch-action: manipulation

      &:hover
        background: rgba(34, 211, 238, 0.12)
        color: #22d3ee
        border-color: #22d3ee

      &:active
        background: rgba(34, 211, 238, 0.2)

    .series-actions
      display: flex
      flex-direction: column
      gap: 4px
      margin-top: 4px

      .series-actions-row
        display: flex
        gap: 4px

      .series-actions-row--tab
        .action-btn
          flex: 1

      .action-btn
        flex: 1
        display: flex
        align-items: center
        justify-content: center
        gap: 3px
        padding: 4px 4px
        border-radius: 4px
        background: rgba(255, 255, 255, 0.04)
        border: 1px solid rgba(255, 255, 255, 0.08)
        cursor: pointer
        font-size: 10px
        font-weight: 500
        color: #8ea4b8
        transition: all 0.2s
        touch-action: manipulation
        white-space: nowrap
        min-width: 0

        &:hover
          background: rgba(34, 211, 238, 0.1)
          color: #22d3ee
          border-color: rgba(34, 211, 238, 0.3)

        &.loading
          color: #f59e0b
          pointer-events: none
          border-color: rgba(245, 158, 11, 0.3)

        &.loaded
          color: #10b981
          pointer-events: none
          border-color: rgba(16, 185, 129, 0.2)
          background: rgba(16, 185, 129, 0.06)

        &.done
          color: #10b981
          border-color: rgba(16, 185, 129, 0.3)

        &.error
          color: #ef4444
          border-color: rgba(239, 68, 68, 0.3)

      .action-open
        border-color: rgba(34, 211, 238, 0.15)
        color: #22d3ee

        &:hover
          background: rgba(34, 211, 238, 0.12)
          border-color: rgba(34, 211, 238, 0.35)

      @media (max-width: 768px)
        gap: 3px

        .series-actions-row
          gap: 3px

        .action-btn
          padding: 4px 3px
          font-size: 9px
          gap: 2px

    .zip-progress-bar
      height: 3px
      background: rgba(255, 255, 255, 0.06)
      border-radius: 2px
      margin-top: 3px
      overflow: hidden

      .zip-progress-fill
        height: 100%
        background: linear-gradient(90deg, #f59e0b, #22d3ee)
        border-radius: 2px
        transition: width 0.2s

    .zip-error-text
      font-size: 9px
      color: #ef4444
      margin-top: 2px

    .zip-recommendation-text,
    .tab-recommendation-text
      font-size: 9px
      color: #22d3ee
      margin-top: 2px
      font-style: italic
      opacity: 0.7


.draggable
  cursor: copy
  cursor: -webkit-grab
  cursor: -moz-grab
