# =============================================================================
# PUTRACNS — FRONTEND BASE image (heavy build stages)
# =============================================================================
# Purpose:
#   Builds the expensive frontend artifacts (React app, OHIF viewer, Stone
#   WASM) ONCE and packages them into a small image that can be pushed to a
#   registry (Docker Hub / GHCR). The Mac mini then only needs to PULL this
#   base image — it never runs webpack/Terser, so it never hits the memory
#   spike that caused the OOM kills.
#
# Build (do this on a capable machine, or overnight when idle):
#   DOCKER_BUILDKIT=1 docker build \
#     -f Dockerfile.frontend-base \
#     -t anastharek/pcns-frontend-base:v9 \
#     .
#
# Push:
#   docker push anastharek/pcns-frontend-base:v9
#
# Requires: DOCKER_BUILDKIT=1 (default in Docker 23+)
# =============================================================================

# ─── Shared base: Yarn config ────────────────────────────────────────────
FROM node:16.20.0 AS yarn-base
RUN yarn config set registry https://registry.npmjs.org \
 && yarn config set network-timeout 600000 \
 && yarn config set prefer-offline true \
 && yarn config set progress false


# ─── React Frontend build ────────────────────────────────────────────────
FROM yarn-base AS react
WORKDIR /app

# Layer 1: Dependencies (cached unless package.json/yarn.lock change)
COPY ./FrontEnd/package.json ./FrontEnd/yarn.lock* ./
RUN --mount=type=cache,target=/root/.yarn \
    yarn install --ignore-engines

# Layer 2: Source + build (only re-runs on source changes)
COPY ./FrontEnd .
ENV NODE_OPTIONS="--max-old-space-size=2048"
ENV GENERATE_SOURCEMAP=false
RUN npm run build


# ─── OHIF Viewer build (v3.13.0 — Node >=24, pnpm 11, rspack) ─────────────
FROM node:24.15.0-slim AS ohif
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential python3 \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11
WORKDIR /ohif/Viewers
COPY ./ohif/Viewers .
ARG QUICK_BUILD=false
ENV QUICK_BUILD=${QUICK_BUILD}
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --no-frozen-lockfile \
 && node scripts/patch-cornerstone.mjs \
 && cd platform/app \
 && PUBLIC_URL=/viewer-ohif/ NODE_OPTIONS=--max-old-space-size=4096 \
    npx rspack build --config .webpack/webpack.pwa.js


# ─── Stone Web Viewer assets ─────────────────────────────────────────────
FROM alpine:3.20 AS stone
RUN apk --no-cache add unzip
WORKDIR /tmp
COPY ["stone/wasm-binaries.zip", "."]
RUN mkdir -p /stone && unzip -q wasm-binaries.zip -d /stone


# ─── Package ONLY the artifacts into a tiny base image ───────────────────
# This final stage contains no node_modules, no source — just the finished
# static assets that the thin runtime Dockerfile will COPY from.
FROM alpine:3.20 AS frontend-base

COPY --from=react /app/build                              /artifacts/build
COPY --from=ohif  /ohif/Viewers/platform/app/dist         /artifacts/viewer-ohif
COPY --from=stone /stone/wasm-binaries/StoneWebViewer     /artifacts/viewer-stone
COPY --from=react /app/build/viewer-ohif/app-config.js    /artifacts/viewer-ohif/app-config.js

# Labels for traceability
LABEL org.opencontainers.image.title="pcns-frontend-base" \
      org.opencontainers.image.description="Pre-built FASTPACS frontend artifacts (React + OHIF + Stone)"

CMD ["true"]
