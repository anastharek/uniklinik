<div style="max-width: 560px; padding: 20px; background: #ffffff; border-radius: 5px; margin: 40px auto; font-family: Open Sans,Helvetica,Arial; font-size: 15px; color: #666;">
    <div style="color: #444; font-weight: normal;">
      <div style="text-align: center; font-weight: 600; font-size: 26px; padding: 10px 0; border-bottom: solid 3px #eeeeee;">
        {{site_name}}
      </div>
      <div style="clear: both;"></div>
    </div>
    <div style="padding: 0 30px 30px 30px; border-bottom: 3px solid #eeeeee;">
      <div style="padding: 30px 0; font-size: 24px; text-align: center; line-height: 40px;">
        Your One-Time Password (OTP)
        <span style="display: block; font-size: 16px; color: #888;">Use the code below to verify your identity</span>
      </div>
      <div style="padding: 20px; background: #eee; border-radius: 3px; text-align: center; font-size: 28px; font-weight: bold; color: #333;">
        {{otp_code}}
      </div>
      <div style="margin-top: 20px; text-align: center; font-size: 14px; color: #888;">
        This code will expire in 5 minutes.
      </div>
    </div>
    <div style="color: #999; padding: 20px 30px;">
      <div>If you did not request this OTP, please ignore this email.</div>
      <div>Thank you!<br>The PadiMedical Team</div>
    </div>
  </div>
  