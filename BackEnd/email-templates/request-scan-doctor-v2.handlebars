<!doctype html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
  <title>
  </title>
  <!--[if !mso]>-->
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <!--<![endif]-->
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="only">
  <style type="text/css">
    #outlook a {
      padding: 0;
    }

    body {
      margin: 0;
      padding: 0;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table,
    td {
      border-collapse: collapse;
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }

    img {
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
      -ms-interpolation-mode: bicubic;
    }

    p {
      display: block;
      margin: 10px 0;
      font-size: 14px;
      color: #000;
      font-family: Arial, Helvetica, sans-serif;
    }
    label{
      font-size: 14px;
      color: #000;
      font-family: Arial, Helvetica, sans-serif;
    }
    .western strong{
      display: inline-block;
      margin-right: 8px;
    }
  </style>
  <!--[if mso]>
        <xml>
        <o:OfficeDocumentSettings>
          <o:AllowPNG/>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
        </xml>
        <![endif]-->
  <!--[if lte mso 11]>
        <style type="text/css">
          .mj-outlook-group-fix { width:100% !important; }
        </style>
        <![endif]-->
  <style type="text/css">
    @media only screen and (min-width:480px) {
      .mj-column-per-100 {
        width: 100% !important;
        max-width: 100%;
      }

      .mj-column-per-33-33333333333333 {
        width: 33.33333333333333% !important;
        max-width: 33.33333333333333%;
      }
    }
  </style>
 
  

</head>

<body style="background-color:#fdfdfd;">
  
  <div class="bgmain" style="background:#ffffff;background-color:#ffffff;margin:0px auto;max-width:900px;">
      <table class="main-table" width="900" align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background:#ffffff;background-color:#ffffff;width:100%;">
        <tbody>
          <tr>
            <td style="direction:ltr;">
                <!----Header--->
                <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                  <tbody>
                    <tr>
                      <td style="padding:0px 15px;word-break:break-word;background: #f7f7f7;" >
                        <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                          <tr style="vertical-align:middle; text-align: center;">
                              <td style="vertical-align:top; padding-right: 10px;" >
                                <!---Logo-->
                                <a href="#" target="_blank" style="display:inline-block;margin:45px auto 0;text-decoration:none;text-transform:none;mso-padding-alt:0px;text-align: center;width: 300px;" width="300">
                                  <img alt="logo" height="auto" src="cid:logo" style="border:0;display:block;outline:none;text-decoration:none;height:auto;width:300px;margin:0 auto;" width="300" />
                                </a>
                              </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding:0px 80px 40px;word-break:break-word;text-align: center; color: #555;background: #f7f7f7;" >
                        
                      </td>
                    </tr> 
                  </tbody>
                </table>
                <!--TagLine--->
                <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                  <!--<tbody>
                    <tr>
                      <td style="padding:10px 50px;word-break:break-word;text-align: center; color: #555;background: #9eacb3;" >
                        <h2 style="word-break:break-word;text-align: center; color: #fff; font-size:20px; display:block; font-weight:bold;font-family: Arial, Helvetica, sans-serif;line-height: 1.4;">IMAGING DEPARTMENT</h2>
                          
                      </td>
                    </tr> 
                  </tbody>--->
                </table>
                <!-- PAYMENT CHECKLIST -->
                <table cellpadding="0" border="1" cellspacing="0" role="presentation" width="100%" style="border:1px solid #cfcfcf;">
                  <tbody>
                      <tr valign="top">
                          <td rowspan="6" style="padding:10px 20px;">
                             <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                              <tbody>
                                <tr>
                                  <td>
                                    <input type="checkbox" name="CASH" id="CASH" checked> <label for="SEGERA">CASH</label>
                                  </td>
                                  <td>
                                    <input type="checkbox" name="GL_PANEL" id="GL_PANEL"> <label for="AWAL">GL/PANEL</label>
                                  </td>
                                  <td>
                                    <input type="checkbox" name="BILL" id="BILL"><label for="BIASA">BILL TO CLINIC</label>
                                  </td>
                                  <td>
                                    <input type="checkbox" name="WARD" id="WARD"><label for="BIASA">WARD/CLINIC</label>
                                  </td>
                                </tr> 
                              </tbody>
                            </table>
                          </td>
                      </tr>
                </table>
                <!-- PAYMENT CHECKLIST -->
                <table cellpadding="0" border="1" cellspacing="0" role="presentation" width="100%" style="border:1px solid #cfcfcf;">
                  <tbody>
                      <tr valign="top">
                          <td rowspan="6" style="padding:10px 20px;">
                             <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                              <tbody>
                                <tr>
                                  <p class="western"><strong>Name:</strong><span>{{ patient_name}}</span></p>
                                  <p class="western"><strong>R/N:</strong><span>{{patient_id}}</span></p>
                                  <p class="western"><strong>Request date for Scan:</strong><span>{{date}}</span></p>
                                  <p class="western"><strong>Request By:</strong><span>{{clinic_name}}</span></p>
                                  <p class="western"><strong>Modality Request:</strong><span>{{modality}}</span></p>
                                 
                                </tr> 
                              </tbody>
                            </table>
                          </td>
                      </tr>
                </table>
                <!-- CLINICAL SUMMARY -->
                <table cellpadding="0" border="1" cellspacing="0" role="presentation" width="100%" style="border:1px solid #cfcfcf;">
                  <tbody>
                      <tr valign="top">
                          <td rowspan="6" style="padding:10px 20px;">
                             <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                              <tbody>
                                <tr>
                                  <p class="western"><strong>Clinical Summary / Diagnosis:</strong><span></span></p>
                                  <p class="western"><strong></strong><span>{{indication}}</span></p>
                                  <p class="western"><strong></strong><span></span></p>
                                </tr> 
                              
                            </table>
                        </td>
                      </tr>
                  </tbody>
                </table>
                <!-- RADIOLOGICAL EXAMINATION -->
                <table cellpadding="0" border="1" cellspacing="0" role="presentation" width="100%" style="border:1px solid #cfcfcf;">
                  <tbody>
                      <tr valign="top">
                          <td rowspan="6" style="padding:10px 20px;">
                             <table border="0" cellpadding="0" cellspacing="0" role="presentation" width="100%">
                              <tbody>
                                <tr>
                                  <p class="western"><strong>Radiological Exammination:</strong><span></span></p>
                                  <p class="western"><strong></strong><span>{{modality}}</span></p>
                                  <p class="western"><strong></strong><span></span></p>
                                  <p class="western"><strong></strong><span></span></p>
                                  <p class="western"><strong></strong><span></span></p>
                                  <p class="western"><strong></strong><span></span></p>
                                </tr> 
                              
                            </table>
                        </td>
                      </tr>
                  </tbody>
                </table>
                <!--Table content-->
                <table cellpadding="0" border="1" cellspacing="0" role="presentation" width="100%" style="border:1px solid #cfcfcf;">
                    <tbody>
                      <tr valign="top">
                          <td style="padding:10px 20px;">
                              <p class="western"><strong>Study No:</strong><span></span></p>
                              <p class="western"><strong></strong><span></span></p>
                          </td>
                          <td style="padding:10px 20px;">
                              <p class="western"><strong>Physician:</strong><span></span></p>
                              <p class="western"><strong></strong><span>Dr. {{req_user}}</span></p>
                              <p class="western"><strong></strong><span>{{doctor_description}}</span></p>
                              <p class="western"><strong></strong><span></span></p>
                              <p class="western"><strong></strong><span></span></p>
                          </td>
                      </tr>
                    </tbody>
                    
                </table>
                
                <table cellpadding="0"  cellspacing="0" role="presentation" width="100%" style="border:1px solid #cfcfcf;">
                  <tbody>
                    <tr>
                      <td>
                        <h4 style="padding-left: 10px;word-break:break-word; color: #000; font-size:14px; display:block; font-weight:normal;font-family: Arial, Helvetica, sans-serif;line-height: 1.3;">
                        Computer generated , no signature required.<br/>
                       
                        </h4>
                      </td>
                      
                      
                  </tr>
                  </tbody>
                </table>
                <!--Footer--->
            </td>
          </tr>
        </tbody>
      </table>
  </div>
  
</body>

</html>
